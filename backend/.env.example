# ==========================================
# SkillBridge Backend Environment Variables
# ==========================================

# Node Environment ('development' or 'production')
NODE_ENV=development

# Server Port (Render injects PORT dynamically in production)
PORT=5000

# JSON Web Token Secret (used for signing student & admin session tokens)
# On Render: automatically provisioned via generateValue: true
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# MySQL Database Connection Settings
# Note: Render does not host managed MySQL; use an external MySQL 8.0+ provider
# (e.g., Aiven, DigitalOcean Managed MySQL, Railway, AWS RDS, or Clever Cloud).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skillbridge
DB_USER=root
DB_PASSWORD=your_mysql_password

# Enable SSL for cloud MySQL providers requiring TLS (e.g. Aiven, AWS RDS)
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false

# Schema Synchronization Safety
# In production, defaults to safe sync (CREATE TABLE IF NOT EXISTS without altering existing tables).
# Set to 'true' only if you explicitly want Sequelize to alter tables on startup.
DB_SYNC_ALTER=false

# Allowed Frontend Origins for CORS
# Comma-separated list for multiple domains (e.g. https://skillbridge-frontend.onrender.com)
FRONTEND_URL=http://localhost:5173
