# ===========================================
# SkillBridge Frontend Environment Variables
# ===========================================

# Production API Base URL
# In local development, leave this empty to use the Vite proxy (/api -> http://localhost:5000).
# In production on Render Static Sites, set this to your deployed Render backend service URL.
# Example: https://skillbridge-backend.onrender.com
VITE_API_URL=https://skillbridge-backend.onrender.com
